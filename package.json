{
  "name": "priority-mcp-server",
  "version": "0.2.0",
  "description": "MCP server for Priority ERP OData API",
  "type": "module",
  "license": "MIT",
  "author": "Community",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropic-community/priority-mcp-server"
  },
  "keywords": [
    "mcp",
    "priority",
    "erp",
    "odata",
    "claude"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "priority-mcp-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --experimental-strip-types src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "web:setup": "npm run build && node dist/web/setup.js",
    "web:start": "node dist/web/index.js",
    "test:web": "vitest run tests/web",
    "test:mcp": "npm run build && node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "inspect": "npx @modelcontextprotocol/inspector node --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.14",
    "pino": "^9.6.0",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
