# ============================================================================
# Priority MCP Server — environment configuration
# Copy to .env (which is git-ignored) and fill in real values.
# ============================================================================

# --- Connection ---------------------------------------------------------------
# The OData service root is assembled as:
#     {PRIORITY_API_URL}/{PRIORITY_ENVIRONMENT}/{PRIORITY_COMPANY}
# For the values below that resolves to:
#     https://your-server.com/odata/Priority/tabula.ini/demodata
# PRIORITY_API_URL = everything up to and including /odata/Priority
PRIORITY_API_URL=https://your-server.com/odata/Priority
# PRIORITY_ENVIRONMENT = the system .ini segment. Almost always "tabula.ini".
# Append a numeric language code to control Priority's system-message language, e.g.
# "tabula.ini,3". Optional (defaults to tabula.ini).
PRIORITY_ENVIRONMENT=tabula.ini
PRIORITY_COMPANY=demodata

# Escape hatch: if the assembled URL is wrong for your install, set the FULL service
# root here (everything before the form name). It overrides the three vars above.
# PRIORITY_SERVICE_ROOT=https://your-server.com/odata/Priority/tabula.ini/demodata

# --- Authentication (HTTP Basic) ----------------------------------------------
# Preferred token: PRIORITY_PAT=your-token
# PAT / token installs:  PRIORITY_USERNAME = the PAT token, PRIORITY_PASSWORD = PAT
# Classic on-prem:       PRIORITY_USERNAME = API user,       PRIORITY_PASSWORD = password
PRIORITY_USERNAME=apiuser
PRIORITY_PASSWORD=secret

# Optional per-application licensing headers (Priority 18.3+): X-App-Id / X-App-Key
# PRIORITY_APP_ID=
# PRIORITY_APP_KEY=

# --- Behavior (all optional) --------------------------------------------------
# PRIORITY_LANGUAGE=EN                # EN | HE — used for response labelling
# PRIORITY_CUSTOM_PREFIX=ORGT_        # prefix for custom forms
# PRIORITY_CUSTOM_ENTITIES=ORGT_DEBTAGE,ORGT_CUSTOM1
# PRIORITY_READ_ONLY=true             # default true, including unset/unrecognized values
# PRIORITY_ALLOWED_TOOLS=             # comma-separated allowlist (only these register)
# PRIORITY_BLOCKED_TOOLS=             # comma-separated blocklist (these never register)
# CACHE_TTL_SECONDS=60
# CACHE_MAX_BYTES=33554432
# RATE_LIMIT_PER_MINUTE=90
# Shared account alias for different credentials belonging to one API user (operator only).
# This coordinates this process only; budget other integrations/processes separately.
# PRIORITY_RATE_SCOPE=api-user-account
# PRIORITY_MAX_CONCURRENCY=4
# PRIORITY_MAX_PENDING=100
# Decoded streaming response limits; opt in explicitly before raising these.
# PRIORITY_MAX_READ_BODY_BYTES=16777216
# PRIORITY_MAX_METADATA_BODY_BYTES=33554432
# LOG_LEVEL=info                      # trace | debug | info | warn | error
# MCP_TRANSPORT=stdio                 # stdio (local) | http (remote)
# MCP_HTTP_PORT=3000

# PRIORITY_BASE_URL=https://your-server.com/odata/Priority/tabula.ini
# REQUEST_TIMEOUT_MS=120000
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_AUTH_TOKEN=                # required for non-loopback HTTP binding
# MCP_HTTP_ALLOWED_ORIGINS=           # exact comma-separated browser origins

# Optional compact read-focused discovery; explicit allow/block policy is unchanged.
PRIORITY_TOOL_PROFILE=full

# Rollback controls; requests still share the same bounded scheduler.
PRIORITY_COALESCE_READS=true
PRIORITY_REPORT_CONCURRENCY=2
